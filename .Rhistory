library(ggplot2)
set.seed(11)
n <- 100
design  <- rep(c("Old", "New"), each = n)
old_out <- sample(c("Complete", "Abandon"), n, replace = TRUE, prob = c(0.40, 0.60))
new_out <- sample(c("Complete", "Abandon"), n, replace = TRUE, prob = c(0.62, 0.38))
data <- data.frame(design, outcome = c(old_out, new_out))
tbl <- table(data$design, data$outcome)
test <- chisq.test(tbl)
p1 <- ggplot(data, aes(design, outcome)) +
geom_count()
resid_df <- as.data.frame(as.table(test$residuals))
names(resid_df) <- c("design", "outcome", "residual")
p2 <- ggplot(resid_df, aes(design, outcome)) +
geom_count(aes(size = abs(residual), color = residual), stat = "identity") +
scale_color_gradient2(low = "steelblue", mid = "white", high = "firebrick")
p1
p2
