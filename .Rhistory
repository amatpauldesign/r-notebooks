set.seed(7361)
n <- 80
formats  <- c("Video", "Interactive", "Text")
outcomes <- c("Churned", "Casual", "Power user")
video_out       <- sample(outcomes, n, replace = TRUE, prob = c(0.25, 0.50, 0.25))
interactive_out <- sample(outcomes, n, replace = TRUE, prob = c(0.15, 0.45, 0.40))
text_out        <- sample(outcomes, n, replace = TRUE, prob = c(0.35, 0.45, 0.20))
data <- data.frame(
format  = factor(rep(formats, each = n), levels = formats),
outcome = factor(c(video_out, interactive_out, text_out), levels = outcomes)
)
tbl <- table(data$format, data$outcome)
test <- chisq.test(tbl)
test
test$expected
